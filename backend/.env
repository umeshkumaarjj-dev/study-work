# Claude via Amazon Bedrock (not the direct Anthropic API). Leave the two AWS
# key fields blank to fall back to the default AWS credential chain (env vars
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, a shared ~/.aws/credentials profile,
# or an EC2/ECS/Lambda instance role) instead of hardcoding creds here.
BEDROCK_AWS_REGION=us-east-1
BEDROCK_AWS_ACCESS_KEY_ID=AKIA3UALA6U5UJ2TSOYB
BEDROCK_AWS_SECRET_ACCESS_KEY=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
BEDROCK_AWS_SESSION_TOKEN=
# Must match a model you've enabled under Bedrock > Model access in the AWS
# console for BEDROCK_AWS_REGION above. Newer Claude models (like this one)
# only support on-demand invocation via a cross-region inference profile ID
# ("us." prefix), not the bare model ID - using the bare ID fails with
# "Invocation ... with on-demand throughput isn't supported."
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

DATABASE_URL=postgresql://app:app@localhost:5432/selfhealing?schema=public

PORT=4000

JWT_SECRET=dev-only-self-healing-cloud-automation-secret-change-me

# Whoever is signing up as a "lead" must enter this exact code on the signup form.
# Share it only with actual leads/managers - anyone without it is forced into "resource".
LEAD_SIGNUP_CODE=let-me-lead-2026
