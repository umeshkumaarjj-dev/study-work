generator client {
  provider      = "prisma-client-js"
  // "native" for local dev (Windows/Mac); "rhel-openssl-3.0.x" matches AWS
  // Lambda's Node.js 20.x runtime (Amazon Linux 2023) - without it the engine
  // binary generated on your machine won't run once deployed.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Kept as plain strings (not native Postgres enums) so the TypeScript unions in
// src/types.ts stay the single source of truth for valid values - this schema
// was originally written for SQLite (no enum support there) and there was no
// reason to fork the two once moving to Postgres. nodeIds is a JSON-encoded
// string[] (see src/serialize.ts).
model ErrorEvent {
  id            String          @id @default(uuid())
  pipeline      String
  scenarioKey   String
  nodeIds       String
  title         String
  service       String
  rawLog        String
  rootCause     String?
  severity      String?
  fixType       String?
  fixSummary    String?
  fixDetail     String?
  status        String          @default("detected")
  // "simulated" (default, from the scenario simulator) | "aws_live" (from a real
  // connected-AWS resource check) | "scm_live" (from a real connected-GitHub
  // resource check). aws_live/scm_live errors always require manual approval
  // regardless of severity - see engine/errorPipeline.ts.
  origin        String          @default("simulated")
  // Who triggered/detected this. "simulated" events are a personal sandbox: only
  // this user sees them (see routes/errors.ts), and they're deleted when this
  // user logs out (see routes/auth.ts). Real aws_live/scm_live events stay
  // visible to the whole team regardless of who found them.
  userId        String?
  awsServiceKey String?
  awsResourceId String?
  scmNodeKey    String?
  scmResourceId String?
  // Deterministic, code-driven remediation action key (e.g. "ecs_restart_service",
  // "gh_rerun_failed_jobs"); null means no automated remediation is implemented yet
  // for this issue, so approval only logs a manual-action note instead of calling
  // AWS/GitHub. Never derived from the AI's free-text diagnosis - see aws/fixes.ts
  // and scm/fixes.ts.
  fixAction     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  timeline      TimelineEntry[]

  @@index([userId])
  @@index([origin, status])
  @@index([awsServiceKey, awsResourceId])
  @@index([scmNodeKey, scmResourceId])
}

model TimelineEntry {
  id           String     @id @default(uuid())
  errorEvent   ErrorEvent @relation(fields: [errorEventId], references: [id])
  errorEventId String
  message      String
  actor        String
  at           DateTime   @default(now())

  @@index([errorEventId])
}

// Stores SCM/AWS connection settings, one row per (user, type). Secrets
// (patToken, secretAccessKey, ...) live only in `config` (JSON) and are never
// returned by the API - only `summary` (a masked, human-readable description)
// is. Scoped per-user (not global) so one user logging out - or being logged
// out - only ever disconnects their own session, never anyone else's.
model Connection {
  id          String    @id @default(uuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  type        String // "scm" | "aws"
  status      String    @default("disconnected") // "connected" | "disconnected"
  summary     String?
  config      String? // JSON, contains secrets - server-side only
  connectedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, type])
}

// "resource" (engineer doing the fixing) | "lead" (reviews team activity, sees
// the History view + the activity-aware chatbot). Chosen at signup by the user
// themselves (self-service role picker) - see auth/authService.ts.
model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  role         String        @default("resource")
  createdAt    DateTime      @default(now())
  activity     ActivityLog[]
  connections  Connection[]
}

// One row per meaningful action a logged-in user takes (approve/reject a fix,
// check a real AWS/GitHub resource, apply a fix, use the chatbot). This is the
// audit trail leads browse in the History view and query via the chatbot.
model ActivityLog {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  userName     String
  action       String
  targetLabel  String
  errorEventId String?
  details      String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([userName])
  @@index([createdAt])
}

// Persisted (not just live-fetched) so that once an item crosses the 10-day
// "old" threshold, we can ask the user whether to delete it instead of
// silently dropping it - see routes/news.ts. Shared across all users, since
// it's the same public feed content for everyone, not per-user data.
model NewsItem {
  id            String   @id // "<source>:<upstream guid/link>"
  source        String
  sourceLabel   String
  title         String
  link          String
  publishedAt   DateTime
  summary       String
  fetchedAt     DateTime @default(now())
  // User explicitly answered "No, keep it" when prompted - stop asking again.
  keepConfirmed Boolean  @default(false)
  // User explicitly answered "Yes, delete it" - soft-deleted so a later feed
  // sync doesn't just resurrect the same upstream item.
  deleted       Boolean  @default(false)

  @@index([deleted])
}

// A single, shared record (the whole team's picture of their real system, not
// per-user) of which known topology node ids were last confirmed visible in a
// team member's uploaded architecture photo. The photo itself is never
// stored/displayed - instead the CI/CD tab redraws a clean vector diagram of
// exactly this set of nodes (using the same positions/labels as the topology
// API), so it's always crisp regardless of the source photo's quality - see
// routes/diagram.ts.
model ArchitectureDiagram {
  id             String   @id @default("default")
  presentNodeIds String // JSON-encoded string[] of topology node ids
  updatedAt      DateTime @updatedAt
}
